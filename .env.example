# KYNTRA Environment Configuration Template
# Copy to .env and configure credentials. Never commit active credentials.

# OpenF1 Ingestion Configuration
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TOKEN=
OPENF1_USERNAME=
OPENF1_PASSWORD=

# OpenF1 Live MQTT Streaming
OPENF1_MQTT_BROKER=mqtt.openf1.org
OPENF1_MQTT_PORT=8883
OPENF1_MQTT_KEEPALIVE=60

# Live Session Configuration (Defaults to dynamic discovery if left blank)
# OPENF1_SESSION_KEY=
# OPENF1_MEETING_KEY=

# Local Session Capture
KYNTRA_CAPTURE_DIR=data/captures
KYNTRA_AUTO_CAPTURE=false
